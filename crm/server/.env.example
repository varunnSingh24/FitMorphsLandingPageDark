# Copy this file to .env and fill in the values

# Server port (default 3001)
PORT=3001

# CHANGE THIS — use any long random string, keep it secret
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars

# Your deployed frontend URL (no trailing slash)
# For local dev: http://localhost:3000
# For production: https://crm.fitmorphs.com
CLIENT_URL=http://localhost:3000

# Environment
NODE_ENV=production
